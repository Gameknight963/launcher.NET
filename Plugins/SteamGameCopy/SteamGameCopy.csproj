<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>launcherdotnet.Plugins.SteamGameCopy</RootNamespace>
    <NoWarn>$(NoWarn);NU1701;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\launcherdotnet\launcherdotnet.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\ThunderstoreModManager\ThunderstoreModManager.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SteamCopyForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <PluginOutputDir>$(MSBuildThisFileDirectory)..\..\launcherdotnet\bin\$(Configuration)\$(TargetFramework)\plugins\$(TargetName)\</PluginOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)"
          DestinationFolder="$(PluginOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>