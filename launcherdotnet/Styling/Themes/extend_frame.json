{
  "Id": "launcherdotnet.extendframe_theme",
  "UserFriendlyName": "Extended frame",
  "BaseStyle": {
    "BackColor": "#000000",
    "ForeColor": "#FFFFFF",
    "BorderStyle": null,
    "Font": null
  },
  "UseShadowText": true,
  "UseOwnerDrawHeaders": true,
  "AccentState": "ACCENT_DISABLED",
  "Effects": "ExtendFrame",
  "Rules": [
    {
      "Exclude": [
        "System.Windows.Forms.Label, System.Windows.Forms",
        "System.Windows.Forms.Button, System.Windows.Forms",
        "System.Windows.Forms.ComboBox, System.Windows.Forms"
      ],
      "Style": {
        "BackColor": "#000000",
        "ForeColor": "#FFFFFF",
        "BorderStyle": null
      }
    },
    {
      "Include": [
        "System.Windows.Forms.Label, System.Windows.Forms"
      ],
      "Style": {
        "BackColor": "#000000",
        "ForeColor": "#FFFFFF"
      }
    },
    {
      "Include": [
        "System.Windows.Forms.Button, System.Windows.Forms"
      ],
      "Style": {
        "Type": "Button",
        "BackColor": "#000000",
        "ForeColor": "#FFFFFF",
        "FlatStyle": "Flat",
        "BorderColor": "#333333"
      }
    }
  ]
}