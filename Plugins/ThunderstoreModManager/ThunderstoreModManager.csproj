<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1701;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\launcherdotnet\launcherdotnet.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlRenderer.WinForms" Version="1.5.2" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="Markdown.ColorCode" Version="3.0.1" />
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Thunderstore\BigImageViewer.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Thunderstore\FillMissingModInfo.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Thunderstore\ReviewAndConfirm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Thunderstore\ThunderstoreModBrowser.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Thunderstore\ThunderstoreModInstaller.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Thunderstore\UntrackedFilesForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy &quot;$(TargetDir)*.dll&quot; &quot;..\..\launcherdotnet\bin\$(Configuration)\net10.0-windows\plugins\$(TargetName)\&quot; /Y /I" />
  </Target>

</Project>
