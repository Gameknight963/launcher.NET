<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>$(VersionPrefix)2.2.0</Version>
    <Authors>gameknight963</Authors>
    <Description>Lightweight universal game launcher in .net framework</Description>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
	<NoWarn>$(NoWarn);NU1701;NETSDK1137;</NoWarn>
	<ApplicationIcon>icon.ico</ApplicationIcon>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>


  <ItemGroup>
	  <EmbeddedResource Include="icon.ico" />
  </ItemGroup>

  <Target Name="CopyThemesAfterBuild" AfterTargets="Build">
    <Exec Command="xcopy &quot;$(ProjectDir)Styling\themes\*&quot; &quot;$(TargetDir)themes\&quot; /E /I /Y" />
  </Target>
	
  <ItemGroup>
    <PackageReference Include="Cyotek.Windows.Forms.ColorPicker" Version="2.0.0-beta.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Semver" Version="3.0.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Launcher\Forms\GameInstallForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Launcher\Forms\GameModManager.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LICENSE</Link>
    </None>
  </ItemGroup>

</Project>